{
  "version": 3,
  "framework": "angular",
  "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && npm install",
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && npm run build",
  "outputDirectory": "dist/SRP/browser",
  "headers": [
    {
      "source": "/(ngsw-worker\\.js|ngsw\\.json|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|png|svg|ico|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!ngsw-worker\\.js|ngsw\\.json|manifest\\.webmanifest|icons/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
